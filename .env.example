# ===========================================
# NL2Chart Agent - 环境变量配置
# ===========================================
# 使用说明:
# 1. 复制本文件为 .env: cp .env.example .env
# 2. 填入你的实际配置值
# 3. 不要将 .env 文件提交到 Git
# ===========================================

# 大语言模型 API 配置
# 支持 OpenAI 及兼容 API (如 SiliconFlow、智谱、通义千问等)

# API 密钥 (从你的服务商获取)
API_KEY=your-api-key-here

# API 端点地址
# OpenAI: https://api.openai.com/v1/chat/completions
# SiliconFlow: https://api.siliconflow.cn/v1/chat/completions
# 智谱 AI: https://open.bigmodel.cn/api/paas/v4/chat/completions
API_URL=https://api.openai.com/v1/chat/completions

# 模型名称
# OpenAI: gpt-3.5-turbo, gpt-4, gpt-4-turbo
# SiliconFlow: Pro/zai-org/GLM-5
# 智谱: glm-4, glm-4-plus
LLM_MODEL=gpt-3.5-turbo

# 多 Agent 架构 (可选)
# true: 启用 Planner + Executor + Reviewer 多 Agent 协作
# false或不设置: 使用单 Agent 架构
# USE_MULTI_AGENT=true

# SQL Agent 模式 (可选)
# true: 启用 SQL Agent (LLM 自动生成 SQL + Schema 注入 + 安全过滤)
# false或不设置: 不使用
# USE_SQL_AGENT=true

# 服务器端口 (可选，默认 3000)
# PORT=3000

# SQL 网关独立部署端口 (仅独立部署模式生效)
# GATEWAY_PORT=4000

# ===========================================
# 数据库配置
# ===========================================
# 可选值: json (默认), mysql
DB_TYPE=json

# MySQL 配置 (当 DB_TYPE=mysql 时生效)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-password
# MYSQL_DATABASE=nl2chart

# ===========================================
# LangSmith 集成（可选，企业级可观测性）
# ===========================================
# 注册免费账号: https://smith.langchain.com/
# 设了以下三个变量后，所有 LangGraph 节点 / LLM 调用 / 工具调用
# 会自动上报到 LangSmith 仪表盘，可视化 trace + token 统计 + 错误定位

# 启用追踪（true/false）
LANGSMITH_TRACING=false

# API Key (注册后从 https://smith.langchain.com/settings 复制)
# LANGSMITH_API_KEY=lsv2_pt_xxxxxxxxxxxxxxxxxxxxxxxx

# Project 名称（不同业务/环境用不同项目隔离）
LANGSMITH_PROJECT=nl2chart-agent

# 自托管 LangSmith 才需要改（默认 SaaS 不需要）
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
